generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "mysql"
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String
  profilePicture  String?  @map("profile_picture")
  status          String   @default("offline")
  createdAt       DateTime @default(now()) @map("created_at")

  messagesSent    Message[] @relation("messages_sent")
  messagesRecv    Message[] @relation("messages_recv")
  groupMembers    GroupMember[]
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int      @map("sender_id")
  receiverId Int?     @map("receiver_id")
  groupId    Int?     @map("group_id")
  content    String
  type       String   @default("text")
  status     String   @default("sent")
  createdAt  DateTime @default(now()) @map("created_at")

  sender     User     @relation("messages_sent", fields: [senderId], references: [id])
  receiver   User?    @relation("messages_recv", fields: [receiverId], references: [id])
  group      Group?   @relation(fields: [groupId], references: [id])
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  members   GroupMember[]
  messages  Message[]
}

model GroupMember {
  groupId Int   @map("group_id")
  userId  Int   @map("user_id")
  role    String @default("member")

  group   Group @relation(fields: [groupId], references: [id])
  user    User  @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
}
